# Copia este archivo como .env.r2 (en esta misma carpeta) y llena los valores.
# .env.r2 NO se sube a Vercel ni a git. No pegues estos valores en el chat.

# Cloudflare → R2 → Overview → "Account details" → Account ID
R2_ACCOUNT_ID=

# Nombre del bucket que creaste
R2_BUCKET=territorios-vivos-media

# Del token de API de R2 (se muestran UNA sola vez al crearlo)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# URL pública del bucket (Settings → Public access → r2.dev), p. ej. https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=
