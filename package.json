    "media:manifest": "node scripts/media-manifest.mjs",
    "media:audio": "node scripts/optimize-audio.mjs",
    "media:360": "node scripts/optimize-360.mjs",
    "media:transiciones": "node scripts/optimize-transitions.mjs",
    "media:historias": "node scripts/optimize-historias.mjs",
    "media:tienda": "node scripts/optimize-tienda.mjs",
    "media:r2": "node scripts/upload-r2.mjs",
    "map:relief": "node scripts/map-relief.mjs",
