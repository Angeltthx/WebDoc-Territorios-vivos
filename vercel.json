{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && mv dist/index.html dist/app.html",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/video",
      "destination": "https://youtu.be/Glh_bb9vrDM",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!media/|assets/|api/|@)[^.]*)",
      "has": [
        {
          "type": "host",
          "value": "(?:relatos-c9t4\\.territoriosvivos\\.com\\.co|localhost|lvh\\.me)"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/((?!media/|assets/|api/|@)[^.]*)",
      "destination": "/proximamente.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)\\.m3u8",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.apple.mpegurl"
        }
      ]
    },
    {
      "source": "/media/(.*)\\.ts",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp2t"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(self)"
        }
      ]
    }
  ]
}
